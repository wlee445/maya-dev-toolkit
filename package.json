{
  "name": "maya-dev-toolkit",
  "displayName": "Maya Dev Toolkit",
  "description": "Autodesk Maya Dev Toolkit",
  "publisher": "Cx-Game",
  "repository": "https://github.com/wlee445/maya-dev-toolkit",
  "icon": "./icon.png",
  "version": "0.0.8",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Extension Packs",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "python",
    "maya",
    "debugger",
    "autodesk maya",
    "OpenMaya",
    "pymel",
    "cmds",
    "mel"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDebugInitialConfigurations",
		"onDebugDynamicConfigurations:maya-debugpy",
		"onDebugResolve:maya-debugpy",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "maya-dev-toolkit.SendToMaya",
        "title": "Send To Maya"
      },
      {
        "command": "maya-dev-toolkit.MayaPythonDebugger",
        "title": "Maya Python Debugger"
      },
      {
        "command": "maya-dev-toolkit.MayaInitDevDir",
        "title": "Maya Initialize Development Directory Structure"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "maya-dev-toolkit.SendToMaya",
          "when": "(resourceLangId == mayamel) || (resourceLangId == python)"
        }
      ],
      "editor/context": [
        {
          "command": "maya-dev-toolkit.SendToMaya",
          "group": "group1",
          "when": "(resourceLangId == mayamel) || (resourceLangId == python)"
        }
      ]
    },
    "keybindings": [
      {
        "command": "maya-dev-toolkit.SendToMaya",
        "key": "ctrl+alt+F5",
        "when": "(resourceLangId == mayamel || python) && editorTextFocus"
      },
      {
        "command": "maya-dev-toolkit.MayaPythonDebugger",
        "key": "ctrl+alt+p"
      }
    ],
    "languages": [
      {
        "id": "mayamel",
        "aliases": [
          "Maya Mel",
          "maya mel"
        ],
        "extensions": [
          ".mel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mayamel",
        "scopeName": "source.mayamel",
        "path": "./syntaxes/mayamel.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Maya Dev Toolkit",
      "properties": {
        "maya.InstallRootDir": {
          "type": "string",
          "default": "C:\\Program Files\\Autodesk",
          "description": "Maya 安装的根目录"
        },
        "maya.code.DevKitRootDir": {
          "type": "string",
          "default": "",
          "description": "Maya DEVKIT 根目录. eg: ./DevKit/2025/devkitBase"
        },
        "maya.code.MelCompletionPath": {
          "type": "string",
          "default": "",
          "description": "官网上下载开发者包，指认自动补全的路径 \r\n eg : ../devkitBase/devkit/other/docs"
        },
        "maya.code.ExtendLibPath": {
          "type": "string",
          "default": "",
          "description": "Maya 安装路径下的 Python site-packages \r\n eg : C:\\Program Files\\Autodesk\\Maya2025\\Python\\Lib\\site-packages"
        },
        "maya.code.CommandPort": {
          "type": "integer",
          "default": 4648,
          "description": "复制以下代码到 Maya Script Editor （Python）运行\r\n\r\nimport maya.cmds as cmds\r\nif not cmds.commandPort(\":4648\",q=True):cmds.commandPort(n=\":4648\",stp=\"mel\",echoOutput=True)"
        },
        "maya.log": {
          "type": "boolean",
          "default": 0,
          "description": "启动插件时，自动打开 Output log"
        }
      }
    },
    "debuggers": [
      {
        "type": "maya-debugpy",
        "label": "Maya Python Debugger",
        "languages": [
          "python"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "version": {
                "type": [
                  "number",
                  "string"
                ],
                "default": 2025,
                "description": "The version of the Maya exe."
              },
              "connect": {
								"label": "Attach by connecting to debugpy over a socket.",
								"properties": {
									"host": {
										"default": "127.0.0.1",
										"description": "Hostname or IP address to connect to.",
										"type": "string"
									},
									"port": {
										"description": "Port to connect to.",
										"type": [
											"number",
											"string"
										]
									}
								},
								"required": [
									"port"
								],
								"type": "object"
							},
              "autoPort": {
                "type": "boolean",
                "default": true,
                "description": "Automatically assign a port for debugpy to connect on."
              }
            }
          },
          "connect": {
            "properties": {
              "connect": {
								"label": "Attach by connecting to debugpy over a socket.",
								"properties": {
									"host": {
										"default": "127.0.0.1",
										"description": "Hostname or IP address to connect to.",
										"type": "string"
									},
									"port": {
										"description": "Port to connect to.",
										"type": [
											"number",
											"string"
										]
									}
								},
								"required": [
									"port"
								],
								"type": "object"
							}
            }
          },
          "attach":{
            "properties": {
              "processId": {
								"anyOf": [
									{
										"default": "${command:pickProcess}",
										"description": "Use process picker to select a process to attach, or Process ID as integer.",
										"enum": [
											"${command:pickProcess}"
										]
									},
									{
										"description": "ID of the local process to attach to.",
										"type": "integer"
									}
								]
							}
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "maya-debugpy",
            "request": "attach",
            "name": "Maya Python Debugger: Launch Maya",
            "processId": "^\"\\${command:pickProcess}\""
          }
        ],
        "configurationSnippets": [
          {
            "label": "Maya Python Debugger: Connect using Socket",
            "description": "A debug configuration for Connect to a running maya program to debugpy over a socket.",
            "body": {
              "type": "maya-debugpy",
              "request": "connect",
              "name": "Maya Python Debugger: Connect using Socket",
              "connect": {
                "host": "localhost",
                "port": 5678
              }
            }
          },
          {
            "label": "Maya Python Debugger: Attach using Process Id",
            "description": "A debug configuration for attaching to a running maya program by connecting to debugpy over a socket.",
            "body": {
              "type": "maya-debugpy",
              "request": "attach",
              "name": "Maya Python Debugger: Attach using Process Id",
              "processId": "^\"\\${command:pickProcess}\""
            }
          }
        ],
        "variables": {
          "pickProcess": "maya-dev-toolkit.pickLocalProcess"
        }
      }
    ]
  },
  "extensionDependencies": [
    "ms-python.python",
    "ms-python.debugpy"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "net": "^1.0.2",
    "turndown": "^7.2.0"
  }
}
